# ---------------------------------------------------------------------------
# Arc Spend Tracker — environment
# Copy to `.env` and fill in. `.env` is git-ignored. TESTNET KEYS ONLY.
# ---------------------------------------------------------------------------

# --- Network (Arc Testnet, official values from docs.arc.io) ---------------
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER=https://testnet.arcscan.app
# ERC-20 interface of native USDC on Arc Testnet (6 decimals). What x402 transfers.
ARC_TESTNET_USDC=0x3600000000000000000000000000000000000000

# --- Wallets ---------------------------------------------------------------
# Arc-Deployer: deploys SpendLogger, receives x402 payments, settles them,
# calls logPurchase. Export from MetaMask: Account details -> Show private key.
DEPLOYER_ADDRESS=0x52DF4736C94BA91cf7d49b84b642089F85A47C77
DEPLOYER_PRIVATE_KEY=0x...

# Arc-Agent: pays the service via x402.
AGENT_ADDRESS=0xaAf714460A9FbEc7C3f0618cf04E84938b86DC8D
AGENT_PRIVATE_KEY=0x...

# --- Service (filled in at Step 5) -----------------------------------------
SERVICE_PORT=3001
# Price per call in USDC base units (6 decimals). 10000 = $0.01
SERVICE_PRICE_BASE_UNITS=10000
# SpendLogger address — written to deployed.json by scripts/deploy.js
SPEND_LOGGER_ADDRESS=

# --- Agent (filled in at Step 6) -------------------------------------------
SERVICE_URL=http://localhost:3001
